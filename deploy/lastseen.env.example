# /etc/lastseen/lastseen.env  (owner root, mode 0600)
# Values containing $ or spaces must stay single-quoted.

# Where the web server listens (Caddy proxies to it). Keep it on loopback.
LASTSEEN_ADDR=127.0.0.1:8080

# Public URL, used in emails.
LASTSEEN_BASE_URL=https://status.dhruvp.tech

# Admin password hash. Generate with:  /opt/lastseen/lastseen hash-password
LASTSEEN_ADMIN_PASSWORD_HASH='$2a$12$REPLACE_ME'

# Email notifications (port 587 = STARTTLS, 465 = implicit TLS).
LASTSEEN_SMTP_HOST=smtp.example.com
LASTSEEN_SMTP_PORT=587
LASTSEEN_SMTP_USER=
LASTSEEN_SMTP_PASS=
LASTSEEN_SMTP_FROM=lastseen@dhruvp.tech
LASTSEEN_SMTP_TO=you@example.com

# Optional
# LASTSEEN_CHECK_INTERVAL=20m   # normal gap between checks
# LASTSEEN_BACKUP_KEEP=14       # daily snapshots to retain

# NEVER set these in production (development only):
# LASTSEEN_DEV_ALLOW_PRIVATE=1
# LASTSEEN_DEV_INSECURE_COOKIES=1
