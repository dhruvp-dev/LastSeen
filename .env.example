# Local Environment Variables for Last Seen
# Copy this file to .env:  cp .env.example .env

# Web Server (default: 127.0.0.1:8080)
LASTSEEN_ADDR=127.0.0.1:8080

# Public URL (used in emails & links)
LASTSEEN_BASE_URL=http://localhost:8080

# Admin Password Hash (generate with: go run ./cmd/lastseen hash-password)
LASTSEEN_ADMIN_PASSWORD_HASH=

# Turso DB (leave empty to use local SQLite at ./data/lastseen.db)
LASTSEEN_TURSO_URL=
LASTSEEN_TURSO_AUTH_TOKEN=

# Development flags
LASTSEEN_DEV_INSECURE_COOKIES=1
LASTSEEN_DEV_ALLOW_PRIVATE=0

# Email notifications (optional)
# LASTSEEN_SMTP_HOST=smtp.example.com
# LASTSEEN_SMTP_PORT=587
# LASTSEEN_SMTP_USER=
# LASTSEEN_SMTP_PASS=
# LASTSEEN_SMTP_FROM=alerts@dhruvp.tech
# LASTSEEN_SMTP_TO=you@example.com
